<%- include('../partials/head') %>

<section class="page-hero">
  <div class="container narrow center">
    <h1>Contact us</h1>
    <p class="lead">Questions about the product, your order or a refund? We usually reply within 24 to 48 hours on business days.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="card contact-card">
      <span class="icon-circle"><svg width="26" height="26" aria-hidden="true"><use href="#i-mail"/></svg></span>
      <h2>Email support</h2>
      <p><a class="btn" href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <p><strong><%= site.businessName %></strong><% if (site.businessAddress) { %><br><%= site.businessAddress %><% } %></p>
      <p class="fine">For order status and refunds of purchases made on the checkout page, please include your order number. Refund requests are handled by the retailer that processed your order.</p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
