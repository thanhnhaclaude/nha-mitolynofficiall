<header class="site-header" id="top">
  <div class="topbar">
    <div class="container topbar-inner">
      <a href="mailto:<%= site.email %>"><svg width="14" height="14" aria-hidden="true"><use href="#i-mail"/></svg> <%= site.email %></a>
      <span class="topbar-note">Free US shipping on 3 &amp; 6 bottles &middot; <%= guaranteeDays %>-day guarantee</span>
    </div>
  </div>
  <div class="container nav-wrap">
    <a class="logo" href="/" aria-label="<%= site.name %> home">
      <span class="logo-word"><% site.name.toUpperCase().split('').forEach((ch, i) => { %><span class="lc lc-<%= i % 4 %>"><%= ch %></span><% }) %></span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg width="26" height="26"><use href="#i-menu"/></svg>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href="/" <%= path === '/' ? 'aria-current=page' : '' %>>Home</a>
      <a href="/ingredients" <%= path === '/ingredients' ? 'aria-current=page' : '' %>>Ingredients</a>
      <a href="/#what-is">About</a>
      <a href="/faq" <%= path === '/faq' ? 'aria-current=page' : '' %>>FAQ</a>
      <a class="btn btn-yellow btn-sm" href="/#pricing">Check Your Best Price <svg class="hand" width="22" height="22" aria-hidden="true"><use href="#i-hand"/></svg></a>
    </nav>
  </div>
</header>
