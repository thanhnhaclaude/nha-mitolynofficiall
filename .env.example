# Copy this file to .env and fill in your values. Never commit .env.
PORT=3000
NODE_ENV=production

# Public URL of the site (no trailing slash) - used for canonical, sitemap, Open Graph
SITE_URL=https://mitolynofficiall.com
SITE_NAME=Mitolyn
CONTACT_EMAIL=support@mitolynofficiall.com
BUSINESS_NAME=Your Business Name LLC
BUSINESS_ADDRESS=123 Example St, City, State, ZIP, USA

# Where every "Buy" button sends the visitor (your affiliate hoplink or checkout URL)
ORDER_URL=https://example.com/your-affiliate-link

# true = show affiliate disclosure (required by FTC if you earn commission)
AFFILIATE_MODE=true

# Tracking (leave empty to disable)
GTM_ID=
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
BING_UET_ID=
# Site verification meta tags
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
